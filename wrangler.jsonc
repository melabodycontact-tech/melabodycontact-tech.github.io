// Cloudflare Workers config for deploying the mela site (used at launch, not needed locally).
{
  "name": "mela",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // Set this to your real domain once it's connected, e.g. "https://www.yourdomain.com"
    "SITE_URL": ""
  }
}
